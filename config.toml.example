# Copy this file to config.toml and update the values for your device.
# Note: only src/config.toml is gitignored — the
# tracked root config.toml must never contain real credentials.

[app]
mock_wifi = false    # use MockWifiManager instead of WifiManager

[slideshow]
interval    = 30        # seconds between slides
fit_mode    = "fit"     # "fit" = blurred bars, "fill" = cropped
shuffle     = true
transition  = "crossfade"  # "crossfade" | "cut" | "slide"

[display]
brightness    = 72      # 0–100
show_clock    = true
timezone_auto = true

[sleep]
enabled    = false
sleep_time = "22:00"   # 24-hour HH:MM
wake_time  = "07:00"   # 24-hour HH:MM

[sync]
# Which album provider to use: "onedrive", "local", or "google".
# Unknown values fail startup with a clear error.
provider         = "local"
interval_minutes = 60

[sync.onedrive]
# Used when provider = "onedrive".
share_url = "https://1drv.ms/f/YOUR_SHARE_URL_HERE"
password  = ""
cache_dir = "/home/frame/.cache/piframe/onedrive"

[sync.local]
# Used when provider = "local".  The user manages this directory.
source_dir = "/home/frame/Pictures/slideshow"

[sync.google]
# Reserved for the future Google Photos provider.

[system]
timezone = "America/Los_Angeles"

[update]
repo = "njurgens/digital-frame"
