# Git email used for commit identity and signing.
# Set to your GitHub noreply address to avoid privacy rejection:
# DEVCONTAINER_GIT_EMAIL=1845727+username@users.noreply.github.com
DEVCONTAINER_GIT_EMAIL=

# Pi Frame config overrides (prefix: PIFRAME__)
# These override values in config.toml. Only keys that exist in the config
# are overridden; unknown env vars are silently ignored.
# See config.devcontainer.toml for devcontainer defaults.
#
# Provider selection:
# PIFRAME__SYNC__PROVIDER=local
#
# OneDrive credentials (when provider=onedrive):
# PIFRAME__SYNC__ONEDRIVE__SHARE_URL=
# PIFRAME__SYNC__ONEDRIVE__PASSWORD=
#
# Output / cache directories:
# PIFRAME__SYNC__OUTPUT_DIR=
# PIFRAME__SYNC__CACHE_DIR=