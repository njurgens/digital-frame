# Git email used for commit identity and signing.
# Set to your GitHub noreply address to avoid privacy rejection:
# DEVCONTAINER_GIT_EMAIL=1845727+username@users.noreply.github.com
DEVCONTAINER_GIT_EMAIL=

# Pi Frame config overrides (prefix: PIFRAME_, path components joined by __)
# These override values in config.toml at startup. Only keys that exist in
# the config are overridden; unknown env vars are silently ignored.
# Protected keys (provider selection, OneDrive credentials) are never
# persisted back to config.toml by the app.
# See config.devcontainer.toml for devcontainer defaults.
#
# Provider selection:
# PIFRAME_SYNC__PROVIDER=local
#
# OneDrive credentials (when provider=onedrive):
# PIFRAME_SYNC__ONEDRIVE__SHARE_URL=
# PIFRAME_SYNC__ONEDRIVE__PASSWORD=
#
# OneDrive cache directory:
# PIFRAME_SYNC__ONEDRIVE__CACHE_DIR=
#
# Local provider source directory:
# PIFRAME_SYNC__LOCAL__SOURCE_DIR=
#
# Sync polling interval (minutes):
# PIFRAME_SYNC__INTERVAL_MINUTES=60
